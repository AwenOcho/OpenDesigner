{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://opendesigner.dev/catalogs/opendesigner-brand/v1/catalog.json",
 "catalogId": "https://opendesigner.dev/catalogs/opendesigner-brand/v1/catalog.json",
 "protocolVersion": "1.0",
 "title": "OpenDesigner brand: Smart UI catalog",
 "description": "Components an assistant may answer with, built only from this system's tokens. Generated by OpenDesigner smartui.py catalog; do not edit.",
 "instructions": "Answer in plain text first. Show a component only when it does a job text cannot: a list to pick from, numbers to compare, a form to fill, a step to approve. When the person asks to see several records (which invoices, my orders), show them in a list or table, not bullets, even two. A question about one thing (when is the next invoice due?) is a short factual answer and stays text (R1). One component per answer unless the person asked for more (R2). Actions that change data (book, pay, send, delete) are buttons the person presses; never claim they happened (R3). Use only the components and properties in this catalog; there are no colour, size, style, class or URL-of-your-choice properties (R4). Every number must come from the data you were given; leave a value out when you do not have it (R6). Text is plain: no HTML or markdown.",
 "components": {
  "KeyFacts": {
   "type": "object",
   "description": "The facts about one thing as label and value rows, with a short note where it helps and a status colour on values that are a status.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "KeyFacts"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 70
    },
    "subtitle": {
     "type": "string",
     "maxLength": 90
    },
    "facts": {
     "type": "array",
     "minItems": 2,
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 32
       },
       "value": {
        "type": "string",
        "maxLength": 120
       },
       "tone": {
        "type": "string",
        "enum": [
         "neutral",
         "accent",
         "success",
         "warning",
         "danger",
         "info"
        ],
        "x-od-token": true
       },
       "note": {
        "type": "string",
        "maxLength": 80
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    },
    "action": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "facts"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "key-facts",
      "group": "answer",
      "name": "Key facts",
      "use": "to give the details of one booking, order, place or product at a glance",
      "use_when": [
       "the person asks for the details of one thing: a flight, a parcel, an apartment, a plan"
      ],
      "avoid_when": [
       "several things side by side: use comparison",
       "two to four headline numbers for a period: use kpi-strip",
       "a step-by-step status over time: use progress-status"
      ],
      "tags": [
       "facts",
       "details",
       "specs",
       "summary",
       "at a glance"
      ],
      "intents": [
       "key facts",
       "at a glance",
       "details of",
       "specs",
       "facts about",
       "what are the details",
       "opening hours",
       "baggage allowance"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "DataTable": {
   "type": "object",
   "description": "A plain table of up to 50 rows with a title and a summary line, sortable by any column and shown ten rows to a page.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "DataTable"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 60
    },
    "summary": {
     "type": "string",
     "maxLength": 120
    },
    "columns": {
     "type": "array",
     "minItems": 2,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 24,
        "minLength": 1
       },
       "align": {
        "type": "string",
        "enum": [
         "start",
         "end"
        ]
       }
      },
      "required": [
       "label"
      ],
      "x-od-name-from": "label"
     }
    },
    "rows": {
     "type": "array",
     "minItems": 1,
     "maxItems": 50,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "cells": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "properties": {
          "text": {
           "type": "string",
           "maxLength": 80
          }
         },
         "required": [
          "text"
         ],
         "x-od-name-from": "text"
        }
       }
      },
      "required": [
       "cells"
      ]
     }
    },
    "more_note": {
     "type": "string",
     "maxLength": 120
    }
   },
   "required": [
    "component",
    "id",
    "columns",
    "rows"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "data-table",
      "group": "data",
      "name": "Data table",
      "use": "for a list of records an assistant or a report fills in, such as invoices, orders or transactions",
      "use_when": [
       "an answer that lists records with the same few fields, where the person may want to sort or page through them"
      ],
      "avoid_when": [
       "two to four headline totals: use kpi-strip",
       "numbers over time: use line-chart or bar-chart",
       "a handful of options to pick from: use result-list or comparison",
       "rows the person must select and act on in bulk: use receipts-table"
      ],
      "tags": [
       "table",
       "rows",
       "sort",
       "pagination",
       "records"
      ],
      "intents": [
       "table",
       "list all",
       "rows",
       "every transaction",
       "export",
       "show me the records",
       "sort by",
       "invoices",
       "orders"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "KpiStrip": {
   "type": "object",
   "description": "Four headline numbers in one band, each with a plain note under it, and a small bar where a share matters.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "KpiStrip"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "label": {
     "type": "string",
     "maxLength": 40
    },
    "stats": {
     "type": "array",
     "minItems": 2,
     "maxItems": 4,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 24
       },
       "value": {
        "type": "string",
        "maxLength": 14
       },
       "share": {
        "type": "number",
        "minimum": 0,
        "maximum": 100,
        "x-od-measure": true
       },
       "warning": {
        "type": "string",
        "maxLength": 16
       },
       "note": {
        "type": "string",
        "maxLength": 44
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    }
   },
   "required": [
    "component",
    "id",
    "stats"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "kpi-strip",
      "group": "data",
      "name": "Stat strip",
      "use": "at the top of a dashboard, for its headline numbers",
      "use_when": [
       "a report or account page that opens with two to four totals before the detail"
      ],
      "avoid_when": [
       "one number tracked against a limit or goal: use budget-meters or savings-goal",
       "numbers over time: use bar-chart",
       "a share of a whole split into parts: use donut-breakdown"
      ],
      "tags": [
       "kpi",
       "stats",
       "summary",
       "dashboard",
       "metrics"
      ],
      "intents": [
       "headline numbers",
       "kpis",
       "metrics",
       "totals",
       "how are we doing",
       "summary numbers",
       "dashboard",
       "how is my",
       "looking so far",
       "year so far",
       "how many trips"
      ],
      "width": "wide",
      "name_from": null
     }
    }
   }
  },
  "ResultList": {
   "type": "object",
   "description": "Up to eight results as cards: a photo, the name, one meta line, an optional detail and badge, a price and one button each.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "ResultList"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 48
    },
    "note": {
     "type": "string",
     "maxLength": 80
    },
    "results": {
     "type": "array",
     "minItems": 1,
     "maxItems": 8,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "image": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "src"
        ],
        "x-od-media": true,
        "properties": {
         "src": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "x-od-url": "image"
         },
         "alt": {
          "type": "string",
          "maxLength": 200
         },
         "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
         },
         "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
         },
         "ratio": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,3}(\\.[0-9]{1,2})?[:/][1-9][0-9]{0,3}(\\.[0-9]{1,2})?$",
          "maxLength": 12
         },
         "credit": {
          "type": "string",
          "maxLength": 120
         }
        }
       },
       "title": {
        "type": "string",
        "maxLength": 40
       },
       "badge": {
        "type": "string",
        "maxLength": 22
       },
       "meta": {
        "type": "string",
        "maxLength": 60
       },
       "detail": {
        "type": "string",
        "maxLength": 110
       },
       "value": {
        "type": "string",
        "maxLength": 12
       },
       "value_note": {
        "type": "string",
        "maxLength": 20
       },
       "action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "label",
         "event"
        ],
        "properties": {
         "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
         },
         "a11y_label": {
          "type": "string",
          "maxLength": 120
         },
         "event": {
          "$ref": "#/$defs/Event"
         }
        },
        "x-od-effect": "none"
       }
      },
      "required": [
       "title",
       "meta",
       "action"
      ],
      "x-od-name-from": "title"
     }
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "results"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "result-list",
      "group": "choose",
      "name": "Result list",
      "use": "when someone asks to find or be shown a few places, stays, products or services and will open one",
      "use_when": [
       "a short list of results to scan and open one: stays, restaurants, products, classes or venues"
      ],
      "avoid_when": [
       "two to four options compared on the same attributes: use comparison",
       "one item in detail: use product-card",
       "rows of records with many columns: use data-table"
      ],
      "tags": [
       "results",
       "search",
       "list",
       "cards",
       "recommendations"
      ],
      "intents": [
       "find",
       "search",
       "options for",
       "show me",
       "recommend",
       "hotels",
       "places",
       "results",
       "suggest some"
      ],
      "width": "medium",
      "name_from": "title"
     }
    }
   }
  },
  "ApprovalPrompt": {
   "type": "object",
   "description": "Asks the person before something that changes data happens: what will happen, the details that matter, a warning when it cannot be undone, and Cancel or the action itself.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "ApprovalPrompt"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 60
    },
    "summary": {
     "type": "string",
     "maxLength": 140
    },
    "details": {
     "type": "array",
     "minItems": 0,
     "maxItems": 6,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 24
       },
       "value": {
        "type": "string",
        "maxLength": 80
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    },
    "warning": {
     "type": "string",
     "maxLength": 140
    },
    "cancel": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    },
    "approve": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "change"
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "cancel",
    "approve"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "approval-prompt",
      "group": "act",
      "name": "Approval prompt",
      "use": "just before an action that sends, pays, books or deletes, so the person confirms it first",
      "use_when": [
       "an assistant is about to do something that changes data (send, pay, book, delete) and the person must say yes first"
      ],
      "avoid_when": [
       "the action already happened: use receipt",
       "the person still has to fill in values: use form-fields",
       "a bill or request that goes through several approvers: use approval-panel"
      ],
      "tags": [
       "confirm",
       "approval",
       "dialog",
       "warning",
       "destructive action"
      ],
      "intents": [
       "confirm before",
       "approve",
       "are you sure",
       "pay",
       "send",
       "delete",
       "cancel my",
       "book it"
      ],
      "width": "narrow",
      "name_from": "title"
     }
    }
   }
  },
  "Receipt": {
   "type": "object",
   "description": "What just happened: a status line in its tone, what was done, a reference number, the lines that matter, a total, a note and up to two next steps.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "Receipt"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "tone": {
     "type": "string",
     "enum": [
      "success",
      "warning",
      "danger",
      "info"
     ],
     "x-od-token": true
    },
    "status": {
     "type": "string",
     "maxLength": 32
    },
    "title": {
     "type": "string",
     "maxLength": 60
    },
    "reference": {
     "type": "string",
     "maxLength": 24
    },
    "lines": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string",
        "maxLength": 28
       },
       "value": {
        "type": "string",
        "maxLength": 40
       }
      },
      "required": [
       "label",
       "value"
      ],
      "x-od-name-from": "label"
     }
    },
    "total_label": {
     "type": "string",
     "maxLength": 24
    },
    "total_value": {
     "type": "string",
     "maxLength": 16
    },
    "note": {
     "type": "string",
     "maxLength": 160
    },
    "primary": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    },
    "secondary": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    }
   },
   "required": [
    "component",
    "id",
    "status",
    "title",
    "lines"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "receipt",
      "group": "confirm",
      "name": "Receipt",
      "use": "right after a booking, payment, order or change went through (or did not), to say what happened",
      "use_when": [
       "an action finished and the person needs the outcome, its reference number and what to do next"
      ],
      "avoid_when": [
       "the action has not happened yet and needs a yes: use approval-prompt",
       "the action failed and can be tried again: use error-retry",
       "a long history of payments or orders: use data-table"
      ],
      "tags": [
       "receipt",
       "confirmation",
       "booking",
       "order",
       "summary"
      ],
      "intents": [
       "confirmation",
       "receipt",
       "booked",
       "it's done",
       "order placed",
       "payment sent",
       "reference number"
