{
 "about": "Parts made ahead of time for this app's read actions, bound to their data (smartui.py templates). live.py fills them by code; the model writes only the sentence.",
 "templates": [
  {
   "action": "list_fines",
   "intent": "a parking fine",
   "when": "count(fines[status=Unpaid]) == 1",
   "part": {
    "component": "KeyFacts",
    "title": "Unpaid parking fine",
    "subtitle": "Vehicle {vehicle}",
    "facts": [
     {
      "label": "Reference",
      "value": "{fines[status=Unpaid][0].reference}"
     },
     {
      "label": "Date",
      "value": "{fines[status=Unpaid][0].date_in_words}, {fines[status=Unpaid][0].time}"
     },
     {
      "label": "Place",
      "value": "{fines[status=Unpaid][0].location}"
     },
     {
      "label": "Reason",
      "value": "{fines[status=Unpaid][0].contravention}"
     },
     {
      "label": "Full amount",
      "value": "{fines[status=Unpaid][0].amount}"
     },
     {
      "when": "fines[status=Unpaid][0].status == Unpaid",
      "then": {
       "label": "Pay by {fines[status=Unpaid][0].discount_ends}",
       "value": "{fines[status=Unpaid][0].discounted_amount}",
       "tone": "accent",
       "note": "The lower amount ends on {fines[status=Unpaid][0].discount_ends}. After that it is {fines[status=Unpaid][0].amount}."
      }
     },
     {
      "when": "fines[status=Unpaid][0].status == Unpaid",
      "then": {
       "label": "Challenge by",
       "value": "{fines[status=Unpaid][0].challenge_until}"
      }
     },
     {
      "label": "Status",
      "value": "{fines[status=Unpaid][0].status}",
      "tone": {
       "tone": "fines[status=Unpaid][0].status",
       "map": {
        "Unpaid": "warning",
        "Paid*": "success"
       }
      }
     }
    ],
    "action": {
     "when": "fines[status=Unpaid][0].status == Unpaid",
     "then": {
      "label": "Pay {fines[status=Unpaid][0].to_pay_now}",
      "event": {
       "name": "pay_fine",
       "context": {
        "reference": "{fines[status=Unpaid][0].reference}"
       }
      }
     }
    }
   }
  },
  {
   "action": "list_fines",
   "intent": "parking fines",
   "part": {
    "component": "DataTable",
    "title": "Parking fines for {vehicle}",
    "columns": [
     {
      "label": "Reference"
     },
     {
      "label": "Date"
     },
     {
      "label": "Time"
     },
     {
      "label": "Location"
     },
     {
      "label": "Contravention"
     }
    ],
    "rows": {
     "each": "fines",
     "item": {
      "cells": [
       {
        "text": "{.reference|or:–}"
       },
       {
        "text": "{.date_in_words|or:–}"
       },
       {
        "text": "{.time|or:–}"
       },
       {
        "text": "{.location|or:–}"
       },
       {
        "text": "{.contravention|or:–}"
       }
      ]
     }
    }
   }
  },
  {
