     },
     {
      "label": "Place",
      "value": "{fine.location}"
     },
     {
      "label": "Reason",
      "value": "{fine.contravention}"
     },
     {
      "label": "Full amount",
      "value": "{fine.amount}"
     },
     {
      "when": "fine.status == Unpaid",
      "then": {
       "label": "Pay by {fine.discount_ends}",
       "value": "{fine.discounted_amount}",
       "tone": "accent",
       "note": "The lower amount ends on {fine.discount_ends}. After that it is {fine.amount}."
      }
     },
     {
      "when": "fine.status == Unpaid",
      "then": {
       "label": "Challenge by",
       "value": "{fine.challenge_until}"
      }
     },
     {
      "label": "Status",
      "value": "{fine.status}",
