  {
   "action": "application_status",
   "intent": "where an application is",
   "part": {
    "component": "ProgressStatus",
    "title": "Application {application.reference}",
    "tone": {
     "tone": "application.current_step",
     "map": {
      "Waiting for your document": "warning",
      "*": "info"
     }
    },
    "status": "{application.current_step}",
    "steps": {
     "each": "application.steps",
     "item": {
      "label": "{.label}",
      "state": {
       "tone": ".state",
       "map": {
        "done": "done",
        "current": "now",
        "*": "next"
       }
      }
     }
    }
   }
  },
