      "name_from": "status"
     }
    }
   }
  },
  "ErrorRetry": {
   "type": "object",
   "description": "Says in plain words what failed and that nothing else broke, with an optional error code, a Try again button and one other way forward.",
   "additionalProperties": false,
   "properties": {
    "component": {
     "const": "ErrorRetry"
    },
    "id": {
     "type": "string",
     "maxLength": 64
    },
    "@accessibility": {
     "$ref": "#/$defs/Accessibility"
    },
    "@metadata": {
     "$ref": "#/$defs/Metadata"
    },
    "title": {
     "type": "string",
     "maxLength": 60
    },
    "message": {
     "type": "string",
     "maxLength": 200
    },
    "detail": {
     "type": "string",
     "maxLength": 60
    },
    "retry": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    },
    "secondary": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "label",
      "event"
     ],
     "properties": {
      "label": {
       "type": "string",
       "minLength": 1,
       "maxLength": 40
      },
      "a11y_label": {
       "type": "string",
       "maxLength": 120
      },
      "event": {
       "$ref": "#/$defs/Event"
      }
     },
     "x-od-effect": "none"
    }
   },
   "required": [
    "component",
    "id",
    "title",
    "message",
    "retry"
   ],
   "metadata": {
    "extensions": {
     "opendesigner": {
      "slug": "error-retry",
      "group": "confirm",
      "name": "Error with retry",
      "use": "when a load, search or action failed and trying again may work",
      "use_when": [
       "something the person asked for failed (a load, a search, a payment that did not start) and trying again may work"
      ],
      "avoid_when": [
       "the action went through, or was refused for a known reason: use receipt with the danger tone",
       "a list loaded and is simply empty: use empty-state",
       "a warning about something that has not failed yet: use approval-prompt"
      ],
      "tags": [
       "error",
       "retry",
       "failed",
       "try again",
       "offline"
      ],
      "intents": [
       "failed",
       "error",
       "couldn't",
       "try again",
       "didn't work",
       "unavailable"
      ],
      "width": "medium",
